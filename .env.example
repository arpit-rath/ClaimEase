# Copy this file to .env.local and fill in real values there.
# Never commit .env.local. Never put real values in this file.

# --- Browser-safe (NEXT_PUBLIC_ values are inlined into the client bundle at build time) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (no NEXT_PUBLIC_ prefix; never import these in client components) ---
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional: Gemini models to try in order, comma-separated.
# Default: gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_MODEL=
